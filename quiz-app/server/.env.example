# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# The connection string for the MongoDB database.
ATLAS_URI="your_mongodb_connection_string_here"

# The name of the specific database to be used within the MongoDB instance.
ATLAS_DBNAME="your_database_name_here"


# ==========================================
# SERVER CONFIGURATION
# ==========================================

# The network port the server will listen on. 
PORT=xxxx


# ==========================================
# PROJECTOR & NETWORK SETTINGS
# ==========================================

# The static IP address of the projector receiver unit on the local network.
PROJECTOR_RECEIVER_IP=192.168.xxx.xxx

# The network port used for sending commands to the projector.
PROJECTOR_PORT=xxxx

# The network port used for managing the zone configuration.
ZONE_CONFIG_PORT=xxxx
